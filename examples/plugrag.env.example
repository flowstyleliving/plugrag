# Export desired values in your shell, or pass this file with Docker --env-file.
# PlugRAG does not automatically load .env files.
RAG_DATA_DIR=.rag-data
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=200
RAG_CHUNK_OVERLAP=50
RAG_HYBRID=true
# RAG_MODEL_PATH=/absolute/path/to/cached/model
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# Optional bearer token for /search and /answer.
# RAG_API_KEY=replace-with-a-long-random-token

# Optional OpenAI-compatible generation (set BOTH model and base URL).
# RAG_LLM_MODEL=your-model-name
# RAG_LLM_BASE_URL=http://127.0.0.1:8001/v1
# RAG_LLM_API_KEY=local
# RAG_LLM_MAX_TOKENS=900
# RAG_LLM_TIMEOUT=120
